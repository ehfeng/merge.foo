APP_ORIGIN="http://127.0.0.1:3000"
# Optional exact trusted origins; keep local sign-in on the configured loopback origin.
APP_ORIGIN_ALIASES="[]"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
AUTH_SECRET=""
GITHUB_APP_SLUG=""

# Optional actual App slug for installation guidance; no invented App identity.
# Legacy AUTH_ALLOWED_GITHUB_ID is ignored: product sign-in is public.

# Shared PostgreSQL is the common option on Cloudflare and Vercel/Node.
# Neon HTTP-compatible PostgreSQL URL; set deliberately through operator secrets.
DATABASE_URL=
# postgres (common) or durable-object (optional Cloudflare-only); unset selects postgres when URL exists.
STATE_STORE=
# Build-only target: cloudflare, node, or vercel. Do not grant workflow writes merely by changing host.

# Workflow write/background configuration (operator-only; off until deliberately approved).
GITHUB_WORKFLOW_WRITES_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
WORKFLOW_RECONCILE_SECRET=
# Optional Vercel Cron credential; must be >=32 characters and configured through secrets.
CRON_SECRET=
# Populate only with selected actual numeric repository/installation IDs; [] runs no workflow.
WORKFLOW_REPOSITORIES=[]
