{
  "name": "merge-foo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "verify": "pnpm typecheck && pnpm test && pnpm test:setup && pnpm test:storage && pnpm build && pnpm test:browser",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "deploy:check": "wrangler deploy --config dist/server/wrangler.json --dry-run",
    "auth:cloudflare": "wrangler login",
    "check:vinext": "vinext check",
    "setup:auth": "python3 scripts/setup_auth.py",
    "setup:github": "python3 scripts/setup_github.py",
    "test:setup": "python3 -m unittest discover -s scripts -p \"test_*.py\"",
    "test:storage": "node scripts/test_plans_runtime.mjs",
    "build:cloudflare": "MERGEFOO_TARGET=cloudflare pnpm build",
    "build:node": "MERGEFOO_TARGET=node pnpm build",
    "build:vercel": "MERGEFOO_TARGET=vercel pnpm build",
    "dev:node": "MERGEFOO_TARGET=node vite dev --host 127.0.0.1 --port 3000",
    "start:node": "node scripts/start_node.mjs",
    "deploy:vercel": "nitro deploy --prebuilt",
    "migrate:state": "node scripts/migrate_state.mjs",
    "test:postgres": "node scripts/test_postgres_runtime.mjs",
    "workflow:reconcile": "node scripts/reconcile_workflows.mjs",
    "test:host:vercel": "node scripts/test_host_runtime.mjs vercel"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vinext/cloudflare": "latest",
    "lucide-react": "^0.468.0",
    "nitro": "3.0.260903-beta",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "latest",
    "vinext": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1",
    "@playwright/test": "^1.58.0",
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "pg": "^8.23.1",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^4.1.11",
    "wrangler": "latest"
  }
}
